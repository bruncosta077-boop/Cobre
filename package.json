{
  "name": "cobre-desktop",
  "version": "3.17.1",
  "description": "Cobre, reprodutor de música local",
  "main": "main.js",
  "author": "Bruno C S Moraes",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "music-metadata": "12.7.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.cobre.desktop",
    "productName": "Cobre",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**",
      "!coverage/**"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "perMachine": false
    }
  },
  "overrides": {
    "minimatch": "^11.0.9"
  }
}
